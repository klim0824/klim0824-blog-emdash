---
// Canonical article URLs are date-prefixed (/articles/{YYYYMMDD}/{slug}).
// This route exists only as a safety net for old/bookmarked /posts/{slug}
// links and redirects to the real location.
import { getEmDashEntry, decodeSlug } from "emdash";
import { getPostUrl } from "../../utils/post-url";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

return Astro.redirect(getPostUrl({ id: slug, data: { published_date: post.data.published_date } }), 301);
---
