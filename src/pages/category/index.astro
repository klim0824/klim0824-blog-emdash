---
import { getTaxonomyTerms } from "emdash";
import Base from "../../layouts/Base.astro";

const categories = await getTaxonomyTerms("category");
const sortedCategories = categories
	.filter((category) => (category.count ?? 0) > 0)
	.sort((a, b) => (b.count ?? 0) - (a.count ?? 0));
---

<Base title="Categories" description="Browse all categories">
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">Browse</span>
			<h1 class="archive-title">Categories</h1>
			<p class="archive-count">
				{sortedCategories.length}
				{sortedCategories.length === 1 ? "category" : "categories"}
			</p>
		</header>

		{
			sortedCategories.length === 0 ? (
				<p class="no-posts">No categories yet.</p>
			) : (
				<ul class="term-list">
					{sortedCategories.map((category) => (
						<li>
							<a href={`/category/${category.slug}`} class="term-link">
								{category.label}
							</a>
							{category.count !== undefined && (
								<span class="term-count">{category.count}</span>
							)}
						</li>
					))}
				</ul>
			)
		}
	</section>
</Base>

<style>
	.archive-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6);
	}

	.archive-header {
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.archive-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-brand);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		margin-bottom: var(--spacing-2);
	}

	.archive-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.archive-count {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.no-posts {
		color: var(--color-muted);
	}

	.term-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
	}

	.term-list li {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		padding: var(--spacing-2) var(--spacing-4);
		background: var(--color-surface);
		border-radius: var(--radius);
	}

	.term-link {
		color: var(--color-text);
		text-decoration: none;
		font-weight: 500;
		transition: color var(--transition-fast);
	}

	.term-link:hover {
		color: var(--color-brand);
	}

	.term-count {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}
</style>
